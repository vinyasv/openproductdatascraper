# Rename this file to .env and fill in your credentials

# Required: OpenAI API Key for data extraction and embedding generation
OPENAI_API_KEY="your_openai_api_key_here"

# Required: Pinecone API Key for storing vectors
PINECONE_API_KEY="your_pinecone_api_key_here"

# Required: The name of your Pinecone index
# Ensure this index exists and has the correct dimension for the chosen embedding model
# (e.g., 1536 for text-embedding-3-small)
PINECONE_INDEX_NAME="your_pinecone_index_name_here"

# Optional: Specify a different OpenAI embedding model if needed
# Default used in the script is text-embedding-3-small
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"